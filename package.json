{
  "name": "kei-pinboard",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun astro dev --host 127.0.0.1",
    "typecheck": "bun --bun astro check",
    "lint": "bun --bun biome check .",
    "format": "bun --bun biome check --write .",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --host 127.0.0.1",
    "test": "bun scripts/verify-browsers.mjs",
    "demo": "bun scripts/preview-fixtures.mjs",
    "social-image": "bun scripts/render-social-image.mjs",
    "verify": "bun run typecheck && bun run lint && bun run build && bun run test"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
