---
import type { Tool } from "../data/tools";
import { localHref } from "../lib/site";
import Arrow from "./Arrow.astro";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const { preview } = tool;
const previewStyle = [
  `--preview-ratio: ${preview.crop.width} / ${preview.crop.height}`,
  `--preview-width: ${(preview.width / preview.crop.width) * 100}%`,
  `--preview-left: ${(-preview.crop.x / preview.crop.width) * 100}%`,
  `--preview-top: ${(-preview.crop.y / preview.crop.height) * 100}%`,
].join(";");
---
<li data-tool-item data-tool-tags={JSON.stringify(tool.tags)}>
  <article class:list={["tool-card", "paper", `tone-${tool.tone}`]} data-tool-card={tool.id}>
    <span class="pin" aria-hidden="true"></span>
    <div class="tool-heading">
      <span class="tool-icon"><img src={localHref(tool.icon)} width="48" height="48" alt="" /></span>
      <h2 id={`title-${tool.id}`}><a class="tool-link" href={tool.href}
        aria-labelledby={`title-${tool.id}`} aria-describedby={`description-${tool.id}`} data-tool={tool.id}>{tool.name}</a></h2>
    </div>
    <div class="tool-tags" role="group" aria-label={`${tool.name} の分類タグ`}>
      {tool.tags.map((tag) => <button type="button" class="tool-tag" data-tool-tag={tag}
        aria-pressed="false" aria-controls="tool-list" disabled><span class="tag">{tag}</span></button>)}
    </div>
    <figure class="tool-preview">
      <picture class="tool-preview-crop" style={previewStyle} data-tool-preview={tool.id}>
        <source type="image/avif" srcset={localHref(preview.avif)} />
        <img src={localHref(preview.png)} width={preview.width} height={preview.height}
          alt={preview.alt} loading="lazy" decoding="async" />
      </picture>
    </figure>
    <p class="tool-description" id={`description-${tool.id}`}>{tool.description}</p>
    <div class="card-bottom" aria-hidden="true"><Arrow /></div>
  </article>
</li>
