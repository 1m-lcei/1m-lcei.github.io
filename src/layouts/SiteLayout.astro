---
import { brandName, localHref, siteDescription, siteName } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
}
const {
  title,
  description = siteDescription,
  noindex = false,
  type = "website",
  publishedTime,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = !noindex && Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const socialImage = canonical && Astro.site
  ? new URL(localHref("og/works-board.png"), Astro.site).href
  : undefined;
const socialImageAlt = "コルクの掲示板に、距離計測・画像領域選択・順位経路の実画面を紙とピンで重ねた作品ボード";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ead8bd" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={localHref("favicon.svg")} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {socialImage && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
    </>}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content={brandName} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <>
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
  </head>
  <body>
    <a href="#main" class="skip-link">本文へ移動</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand paper" href={localHref()}>
          <span class="tape" aria-hidden="true"></span>
          <img src={localHref("favicon.svg")} width="40" height="40" alt="" />
          <span class="brand-wordmark">{brandName}</span>
        </a>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <nav class="social-links" aria-label="連絡先">
          <a class="paper social-link" href="https://x.com/1m_lcei" aria-label="X（@1m_lcei）">
            <span class="tape social-tape" aria-hidden="true"></span>
            <svg width="24" height="24" fill="currentColor" aria-hidden="true"><use href={localHref("social-icons.svg#x")} /></svg>
          </a>
          <a class="paper social-link" href="https://github.com/1m-lcei" aria-label="GitHub（1m-lcei）">
            <span class="tape social-tape" aria-hidden="true"></span>
            <svg width="24" height="24" fill="currentColor" aria-hidden="true"><use href={localHref("social-icons.svg#github")} /></svg>
          </a>
        </nav>
      </footer>
    </div>
  </body>
</html>
